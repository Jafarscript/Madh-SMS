# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Public URL of your deployed external backend (e.g. https://my-backend.onrender.com)
# When set, the frontend on Vercel talks directly to your deployed backend instead of local Vercel serverless.
VITE_API_URL=

# MONGO_URI: Optional MongoDB Connection URI. If not provided, in-memory MongoDB will be used.
MONGO_URI=

# MONGODB_DB_NAME: Specific database name to target on MongoDB Atlas (default: test)
MONGODB_DB_NAME="test"

# MONGODB_MAX_POOL_SIZE: Maximum connection pool size per serverless instance (prevents connection leaks on Vercel/Atlas M0)
MONGODB_MAX_POOL_SIZE="5"

# JWT_SECRET: Secret for signing JWT authentication tokens.
JWT_SECRET="school-sms-jwt-secret-key-2026"

# RESEND_API_KEY: Resend API Key for sending password reset emails and system notifications.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address for Resend (e.g. "School Portal <noreply@yourdomain.com>" or "onboarding@resend.dev")
RESEND_FROM_EMAIL="onboarding@resend.dev"

